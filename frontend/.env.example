# Frontend (Next.js server) configuration. Copy to .env.local if you need to
# change anything; the defaults work for local development.

# Where the Next.js SERVER reaches the FastAPI backend. The browser never
# calls FastAPI directly (backend-for-frontend), so this is not NEXT_PUBLIC_.
# Defaults to http://localhost:8000 in development; required in production.
API_URL=http://localhost:8000

# This app's own public address, used to build client quote links
# (<APP_URL>/q/<token>). Defaults to http://localhost:3000 in development;
# required in production.
APP_URL=http://localhost:3000

# For production with more than one Next.js instance: a shared key so every
# instance can decrypt Server Action payloads (see Next.js self-hosting docs).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
