# Copy this file to `.env` (which is git-ignored) and adjust as needed:
#   cp .env.example .env
#
# Every setting the app needs comes from environment variables (12-factor).
# The values below are safe LOCAL-ONLY defaults. Never commit real secrets.

# --- Postgres container (read by docker-compose.yml) ---
POSTGRES_USER=tradequote
POSTGRES_PASSWORD=tradequote
POSTGRES_DB=tradequote
# Host port the container is published on. 5433 (not the usual 5432) so it
# doesn't collide with a Postgres already installed natively on your machine.
POSTGRES_PORT=5433

# --- Backend (read by backend/app/config.py) ---
# SQLAlchemy URL. "postgresql+psycopg" selects the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://tradequote:tradequote@localhost:5433/tradequote
# local | test | production — lets code/tests know where they're running.
ENVIRONMENT=local

# Secret used to sign login tokens. Generate your own (never reuse this one
# outside local dev):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-only-change-me-0123456789abcdef
# How long a login token stays valid.
ACCESS_TOKEN_TTL_MINUTES=60
